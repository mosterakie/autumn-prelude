# 秋序后端环境配置示例。复制为 .env 后按本机情况填写。
# 所有变量统一带 AUTUMN_ 前缀（见 src/autumn_backend/config.py）。
# 密钥只通过环境配置传入，任何密钥都不得写进代码或提交进仓库。

# ---------------------------------------------------------------- 运行模式 --
# local / dev / test / prod
AUTUMN_ENVIRONMENT=local

# ---------------------------------------------------------------- 数据库 ---
# 应用使用 asyncpg 驱动；Alembic 复用同一个 URL。
AUTUMN_DATABASE_URL=postgresql+asyncpg://autumn:CHANGE_ME@127.0.0.1:5432/autumn
AUTUMN_DB_ECHO=false
AUTUMN_DB_POOL_SIZE=5
AUTUMN_DB_MAX_OVERFLOW=10
AUTUMN_DB_POOL_TIMEOUT=30
AUTUMN_DB_POOL_RECYCLE=1800

# --------------------------------------------------------------- 会话安全 --
# 生产环境必须显式提供；长度不足 32 时启动即失败（fail-closed）。
AUTUMN_SESSION_SECRET=
AUTUMN_CSRF_SECRET=
AUTUMN_AUTH_ENCRYPTION_KEY=
# JSON 数组；生产显式填写自己的 HTTPS Origin。
AUTUMN_TRUSTED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AUTUMN_SESSION_IDLE_HOURS=24
AUTUMN_STEP_UP_MINUTES=15
# 生产 Cookie 使用 __Host- 前缀与 Secure；开发环境使用独立 Cookie 名。
AUTUMN_COOKIE_NAME=autumn_session
AUTUMN_COOKIE_SECURE=false
AUTUMN_SESSION_TTL_HOURS=720

# --------------------------------------------------------------- 时间语义 --
# 每日额度按 Asia/Shanghai 00:00 切分，数据库时间统一 UTC。
AUTUMN_QUOTA_TIMEZONE=Asia/Shanghai

# ------------------------------------------------------------ 可观测性 -----
AUTUMN_LOG_LEVEL=INFO
AUTUMN_LOG_JSON=false
AUTUMN_METRICS_ENABLED=false
AUTUMN_TRACING_ENABLED=false

# ------------------------------------------------------------ 依赖服务 -----
# 也可以在被忽略的 .env.providers.local 中配置；模型列表以当前账号为准。
AUTUMN_LLM_BASE_URL=https://api.deepseek.com
AUTUMN_LLM_API_KEY=
AUTUMN_LLM_MODEL=deepseek-flash
AUTUMN_SEARCH_API_KEY=
AUTUMN_EMBEDDING_BASE_URL=
AUTUMN_EMBEDDING_API_KEY=
AUTUMN_EMBEDDING_MODEL=text-embedding-v4
AUTUMN_PROVIDER_TIMEOUT_SECONDS=45
# 必须通过独立 setup 入口显式初始化，Worker 启动只检查。
AUTUMN_CHECKPOINT_SCHEMA=autumn_checkpoints
AUTUMN_STORAGE_ROOT=./var/storage

# -------------------------------------------------------------- 邮件发送 ---
# 可写入被忽略的 .env.mail.local；授权码为空时不领取 auth.email 任务。
# 只支持隐式 TLS (SSL)，163 使用 smtp.163.com:465。
AUTUMN_SMTP_HOST=smtp.163.com
AUTUMN_SMTP_PORT=465
AUTUMN_SMTP_USERNAME=
AUTUMN_SMTP_PASSWORD=
AUTUMN_SMTP_FROM_EMAIL=
AUTUMN_SMTP_FROM_NAME=秋序
AUTUMN_SMTP_TIMEOUT_SECONDS=20
AUTUMN_FRONTEND_BASE_URL=http://localhost:3000
